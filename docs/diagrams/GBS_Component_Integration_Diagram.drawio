        <mxCell id="e4" value="bulk insert" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1" source="wworker" target="mssql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="SWQL query" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1" source="lworker" target="solarwinds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="bulk insert" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1" source="lworker" target="mssql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="in-memory state (&lt;1ms)" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;dashed=1;" edge="1" parent="1" source="wworker" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="in-memory state (&lt;1ms)" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;dashed=1;" edge="1" parent="1" source="lworker" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="trend &amp; scoped queries" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;dashed=1;" edge="1" parent="1" source="api" target="mssql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="overwrite snapshot" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1" source="demorunner" target="wsource">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="trigger ingest cycle" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;dashed=1;" edge="1" parent="1" source="demorunner" target="wworker">
