        <mxCell id="e3" value="fetch()" style="html=1;fontSize=10;fontColor=#444444;strokeColor=#666666;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1" source="wworker" target="wsource">
          <mxGeometry relative="1" as="geometry" />
